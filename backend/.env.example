# ── AWS Credentials ──────────────────────────────────────────────────────────────
# For local development, use dummy values; real credentials come from the
# environment or AWS credential chain when deployed.
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
AWS_REGION=us-east-1

# ── Bedrock Model ────────────────────────────────────────────────────────────────
# Must be one of the supported Claude model IDs (see config.py for the full list).
MODEL_NAME=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_MAX_TOKENS=1024
BEDROCK_TEMPERATURE=0.2

# ── DynamoDB ─────────────────────────────────────────────────────────────────────
# Leave empty for local DynamoDB (uses local server). Set to a real endpoint for
# AWS DynamoDB or DynamoDB Local.
DYNAMODB_ENDPOINT=
DYNAMODB_TABLE=support_tickets

# ── Frontend / CORS ──────────────────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:5173

# ── App Limits ────────────────────────────────────────────────────────────────────
MAX_MESSAGE_LENGTH=2000
MAX_HISTORY_TURNS=20

# ── Logging ───────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Rate Limiting ─────────────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60

# ── Knowledge Base ────────────────────────────────────────────────────────────────
KB_SEARCH_RESULTS=3
KB_CHUNK_SIZE=500
KB_CHUNK_OVERLAP=50