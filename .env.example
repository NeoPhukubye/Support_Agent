# ═══════════════════════════════════════════════════════════════════════════════
# SupportAI — Environment Variables
# Copy this file to backend/.env and fill in your values.
#
#   cp .env.example backend/.env
#
# Lines starting with # are comments. Never commit backend/.env to version
# control — it is already in .gitignore.
# ═══════════════════════════════════════════════════════════════════════════════


# ── AWS Credentials ────────────────────────────────────────────────────────────
# Used by boto3 (DynamoDB) and langchain-aws (Bedrock).
#
# For local dev with DynamoDB Local, any non-empty string works as placeholder.
# For AWS access, use a real IAM key pair or set up ~/.aws/credentials + leave
# these blank to let boto3 use the default credential chain.

AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# AWS region where your Bedrock models and DynamoDB table live.
AWS_REGION=us-east-1


# ── Amazon Bedrock ─────────────────────────────────────────────────────────────
# The Bedrock model ID passed to ChatBedrockConverse.
#
# Available options (must be enabled in your AWS account → Bedrock → Model access):
#   anthropic.claude-3-5-sonnet-20241022-v2:0   (default, recommended)
#   anthropic.claude-3-haiku-20240307-v1:0       (faster / cheaper)
#   anthropic.claude-3-opus-20240229-v1:0        (most capable)
#
# Cross-region inference profile example (lower latency, automatic failover):
#   us.anthropic.claude-3-5-sonnet-20241022-v2:0

MODEL_NAME=anthropic.claude-3-5-sonnet-20241022-v2:0


# ── DynamoDB ───────────────────────────────────────────────────────────────────
# DYNAMODB_ENDPOINT
#   Set to the DynamoDB Local URL for local development.
#   Remove this variable (or leave it empty) to use the real AWS DynamoDB
#   endpoint resolved automatically by boto3.
#
#   Local dev (matches docker-compose.yml):  http://localhost:8001
#   Inside Docker Compose network:           http://dynamodb-local:8001
#   Production (real AWS):                   (leave blank / unset)

DYNAMODB_ENDPOINT=http://localhost:8001

# Name of the DynamoDB table used to store support tickets.
DYNAMODB_TABLE=support_tickets


# ── Optional: LangSmith tracing ───────────────────────────────────────────────
# Uncomment and set these to enable LangSmith tracing for debugging.
# Sign up at https://smith.langchain.com to get a key.

# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=lsv2_pt_your_key_here
# LANGCHAIN_PROJECT=supportai-dev
